{
  "name": "myapp",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone rewards/mini-game PWA (Cloudflare Workers + D1). Cloned base; rebrand + games + self-signup added later.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute myapp-db --file=./schema.sql --remote",
    "db:harden": "wrangler d1 execute myapp-db --file=./migration-hardening.sql --remote",
    "db:init-local": "wrangler d1 execute myapp-db --file=./schema.sql --local",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.0.0"
  }
}
